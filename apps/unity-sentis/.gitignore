# The controller bundle is a build artifact regenerated by apps/build/
# before each engine build (ROADMAP_PLUGINS.md §2.9 / §3.4). Never commit
# an .onnx or the bundle JSON siblings that ship alongside it here.
com.ainimator.controller/**/StreamingAssets/AInimatorBundle/
**/StreamingAssets/AInimatorBundle/
*.onnx

# Local Unity project scaffolding some developers create alongside the
# package to test it (Assets/, Library/, Temp/, Logs/, ProjectSettings/ of
# a throwaway host project) — never part of the UPM package itself.
/TestProject/Library/
/TestProject/Temp/
/TestProject/Logs/
/TestProject/obj/
